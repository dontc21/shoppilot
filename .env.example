# B站小店官方商家后台入口；客服页由店主手动进入，不猜测地址。
BILIBILI_SHOP_URL=https://shop.bilibili.com/#/db/home

# 使用电脑已安装的 Edge，但采用完全独立的本地用户目录。
SHOPPILOT_BROWSER_CHANNEL=msedge
SHOPPILOT_DRY_RUN=true

# 以下目录都已被 .gitignore 排除，不能提交登录态或买家数据。
SHOPPILOT_PROFILE_DIR=edge_bilibili_profile
SHOPPILOT_STATE_DB=.runtime/bilibili_state.db
SHOPPILOT_SELECTOR_FILE=.runtime/bilibili_selectors.json
SHOPPILOT_INSPECTION_DIR=.runtime/bilibili_inspection
SHOPPILOT_DIAGNOSTIC_DIR=.runtime/bilibili_diagnostics

SHOPPILOT_POLL_SECONDS=2

# 阶段三：本地知识数据库仍在 .runtime 下，禁止提交真实经营资料。
SHOPPILOT_KNOWLEDGE_DB=.runtime/knowledge.db

# DeepSeek 密钥只写入本机 .env，不要粘贴到聊天、日志或 GitHub。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_TOKENS=500
